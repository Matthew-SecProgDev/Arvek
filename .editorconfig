root = true

# General settings
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C and C++ source files
[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 4

# CMake files
[*.cmake]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

# Markdown files
[*.md]
trim_trailing_whitespace = false